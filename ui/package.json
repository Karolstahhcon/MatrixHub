{
  "name": "matrixhub-ui",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.17.0",
  "type": "module",
  "engines": {
    "pnpm": ">=10 <11"
  },
  "pnpm": {
    "overrides": {
      "js-yaml@<4.3.2": ">=4.3.2"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "prepare": "cd .. && husky install ui/.husky",
    "test": "vitest run"
